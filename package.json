{
  "name": "tg-md-msg",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "native/index.js",
    "native/index.d.ts",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "build:rust": "napi build --platform --release --esm -o ./native",
    "build:ts": "tsc",
    "build": "npm run build:rust && npm run build:ts",
    "postinstall": "node scripts/postinstall.js",
    "release": "npx changeset && changeset version && npm install && git add . && git commit -m \"chore(release): update versions\" && changeset tag && git push --follow-tags",
    "test": "vitest run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "napi": {
    "binaryName": "index",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  }
}
